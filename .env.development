NODE_ENV=development

# The browser only talks to the backend-for-frontend. Vue CLI proxies this
# route locally, so production and development use the same relative URL.
VUE_APP_API_BASE=/api

# An optional, separately protected internal Parse Dashboard URL. Leave empty
# for normal deployments; the dashboard is no longer embedded by default.
VUE_APP_DASHBOARD_URL=

# 跳过验证页面路由 多个路由分号隔开 例如：'front;back'
VUE_APP_SKIP_VERIFY_ROUTE='front'

# 高德地图SDK Key
VUE_APP_MAP_KEY = ''
